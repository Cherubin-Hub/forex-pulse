# Server runtime: Node.js 22 or newer
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Same secret as Pulse Gateway. Production Gateway must be an HTTPS origin.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
CROSS_APP_SSO_SECRET=replace-with-a-random-secret-shared-with-your-gateway

# Server-only forex candle access (provider subscription must permit forex/candle).
FINNHUB_API_KEY=
# Explicit demo mode. Sample data never creates or resolves saved trades.
NEXT_PUBLIC_DEMO_MODE=false

# Scheduled /api/cron/scan calls accept only Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-different-random-secret
# Push normalized real observations to /api/feeds/ingest using this separate secret.
MACRO_INGEST_SECRET=replace-with-another-random-secret
# Optional HTTPS adapter returning an array of normalized feed snapshots.
# Cron pulls this adapter before scanning. Never use sample data in this adapter.
MACRO_FEED_URL=
MACRO_FEED_TOKEN=
