# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Pulse Gateway & Cross-App SSO Configuration
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
CROSS_APP_SSO_SECRET=generate-a-secure-64-character-random-hex-string-for-production

# 24/7 Headless Server Cron Secret (for external webhook schedulers like cron-job.org)
CRON_SECRET=generate-a-secure-64-character-random-hex-string